{
  "manifest_version": 3,
  "name": "YouTube 本地字幕",
  "version": "0.1.1",
  "description": "没有字幕时使用本机语音识别，支持英文、中文和双语字幕。",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["storage", "offscreen", "tabCapture", "activeTab"],
  "host_permissions": ["https://www.youtube.com/*", "http://127.0.0.1/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "开始/停止本地字幕"},
  "commands": {
    "toggle-capture": {"suggested_key": {"default": "Alt+Shift+L"}, "description": "开始/停止当前 YouTube 标签页的本地字幕"}
  },
  "options_page": "options.html",
  "externally_connectable": {"matches": ["http://127.0.0.1/*"]},
  "content_scripts": [
    {"matches": ["https://www.youtube.com/*"], "js": ["main.js"], "run_at": "document_start", "world": "MAIN"},
    {"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}
  ],
  "web_accessible_resources": [
    {"resources": ["capture-worklet.js"], "matches": ["https://www.youtube.com/*"]}
  ],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*"}
}
